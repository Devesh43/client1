# ====================================================================
# ANVARD GLOBAL PRIVATE LIMITED — ENVIRONMENT CONFIGURATION
# ====================================================================
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or real credentials.
# ====================================================================

# Canonical website URL (used for sitemaps, OpenGraph, metadata)
NEXT_PUBLIC_SITE_URL="https://anvardglobal.com"

# Official destination for website business enquiries
EMAIL_TO="Anvardglobal@gmail.com"

# Sender identity. With Gmail SMTP this MUST be the authenticated Gmail
# address, or a verified "Send mail as" alias in that Gmail account.
EMAIL_FROM="ANVARD GLOBAL Website <Anvardglobal@gmail.com>"

# Promise shown in the acknowledgement email (plain language).
ENQUIRY_RESPONSE_SLA="one business day"

# Per-instance daily cap for acknowledgement emails (backscatter protection).
MAX_DAILY_ACKNOWLEDGEMENTS="200"

# --------------------------------------------------------------------
# GMAIL SMTP (PRIMARY — RECOMMENDED FOR THIS PROJECT)
# --------------------------------------------------------------------
# 1. Enable 2-Step Verification on the Google account.
# 2. Google Account -> Security -> App passwords -> create one.
# 3. Paste the 16-character App Password below (spaces are fine).
#
# Use port 465 (implicit TLS) or 587 (STARTTLS).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="Anvardglobal@gmail.com"
SMTP_PASS=""

# --------------------------------------------------------------------
# OPTIONAL: RESEND FALLBACK (ONLY IF SMTP IS NOT CONFIGURED)
# --------------------------------------------------------------------
# Requires a verified sending domain. SMTP always takes precedence when
# SMTP_HOST, SMTP_USER, and SMTP_PASS are all set.
RESEND_API_KEY=""

# --------------------------------------------------------------------
# BEHAVIOUR NOTES
# --------------------------------------------------------------------
# - Development without SMTP credentials: submissions are validated and
#   logged to the server console in DEVELOPMENT STAGING MODE. No email
#   leaves the server.
# - Production without SMTP credentials: the API fails loudly with a
#   configuration error instead of silently discarding enquiries.
