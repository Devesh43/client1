# ====================================================================
# ANVARD GLOBAL PRIVATE LIMITED — ENVIRONMENT CONFIGURATION
# ====================================================================

# Canonical website URL (used for sitemaps, OpenGraph, metadata)
NEXT_PUBLIC_SITE_URL="https://anvardglobal.com"

# Official destination for website business enquiries
EMAIL_TO="Anvardglobal@gmail.com"

# Sender identity (must match your verified sending domain or authenticated SMTP account)
EMAIL_FROM="Anvard Global Website <notifications@anvardglobal.com>"

# --------------------------------------------------------------------
# OPTION A: RESEND (RECOMMENDED FOR MODERN PRODUCTION)
# --------------------------------------------------------------------
# Sign up at https://resend.com, verify your custom domain (e.g. anvardglobal.com),
# and paste your production API key below.
RESEND_API_KEY=""

# --------------------------------------------------------------------
# OPTION B: NODEMAILER SMTP (STANDARD CORPORATE MAIL SERVER)
# --------------------------------------------------------------------
# If you prefer using corporate SMTP (Google Workspace, Zoho, Microsoft 365, or hosting provider):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Note: If neither RESEND_API_KEY nor SMTP credentials are provided,
# the enquiry system safely operates in DEVELOPMENT STAGING MODE.
# Submissions are logged to server console and safely staged without errors.
